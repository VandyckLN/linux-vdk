/* ==========================================================================
   Lumen OS — Folha de Estilo Qt 6 Curved Glass do Calamares
   Vidro escuro fosco, bordas especulares, botões em pílula e gradientes periwinkle.
   Alvo: Ubuntu 26.04 LTS (Resolute Raccoon) • Qt 6.x / KF6 Calamares
   ========================================================================== */

/* --- Base Global --- */
QWidget {
    font-family: "Inter", "Ubuntu", -apple-system, sans-serif;
    font-size: 13px;
    color: #f3f5f8;
    selection-background-color: #748dff;
    selection-color: #ffffff;
}

/* Fundo da Janela Principal */
QWidget#mainApp, QDialog#mainApp, QWidget#contentWidget, QWidget#viewManagerWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0d0f14,
        stop:0.42 #141822,
        stop:1.0 #1a1e27);
    color: #f3f5f8;
}

/* --- Barra Lateral Esquerda (Painel de Navegação) --- */
#sidebarApp {
    background-color: rgba(20, 24, 32, 0.92);
    border-right: 1.5px solid rgba(255, 255, 255, 0.16);
    min-width: 220px;
    max-width: 240px;
}

#sidebarMenuApp {
    background: transparent;
    padding: 10px 6px;
}

/* Itens de Etapa da Barra Lateral */
QListView, QTreeView {
    background-color: transparent;
    border: none;
    outline: none;
}

QListView::item, QTreeView::item {
    color: rgba(235, 240, 248, 0.75);
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid transparent;
    margin: 3px 6px;
    font-weight: 500;
}

QListView::item:hover, QTreeView::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
}

QListView::item:selected, QTreeView::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(116, 141, 255, 0.38),
        stop:1 rgba(169, 112, 255, 0.28));
    border: 1.5px solid rgba(255, 255, 255, 0.38);
    color: #ffffff;
    font-weight: 700;
}

/* --- Cards de Conteúdo e Group Boxes (Contêineres de Vidro Fosco) --- */
QGroupBox {
    background-color: rgba(24, 27, 34, 0.68);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    border-radius: 16px;
    margin-top: 20px;
    padding: 16px;
    font-weight: 700;
    color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 10px;
    background-color: rgba(30, 35, 48, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 8px;
    color: #8da2ff;
}

QFrame#panel, QFrame#boxWidget, QFrame[frameShape="1"] {
    background-color: rgba(24, 27, 34, 0.68);
    border: 1.5px solid rgba(255, 255, 255, 0.20);
    border-radius: 16px;
}

/* --- Botões (Pílulas de Vidro e CTAs Primários Vibrantes) --- */
QPushButton {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 14px;
    color: #eef2f8;
    font-weight: 600;
    padding: 8px 18px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.42);
    color: #ffffff;
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.55);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.28);
}

/* CTA de Ação Primária (Avançar / Instalar / Confirmar) */
QPushButton:default, QPushButton#nextButton, QPushButton#actionButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #748dff,
        stop:1.0 #a970ff);
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 14px;
    color: #ffffff;
    font-weight: 700;
    padding: 8px 24px;
}

QPushButton:default:hover, QPushButton#nextButton:hover, QPushButton#actionButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #869cff,
        stop:1.0 #b580ff);
    border-color: rgba(255, 255, 255, 0.75);
}

QPushButton:default:pressed, QPushButton#nextButton:pressed, QPushButton#actionButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6079ea,
        stop:1.0 #955be6);
}

/* --- Campos de Entrada e Combo Boxes --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: rgba(14, 17, 24, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    color: #ffffff;
    padding: 8px 12px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 1.5px solid #748dff;
    background-color: rgba(18, 22, 32, 0.92);
}

QComboBox {
    background-color: rgba(24, 27, 34, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    color: #ffffff;
    padding: 6px 14px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.40);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QComboBox QAbstractItemView {
    background-color: #141720;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    color: #f3f5f8;
    selection-background-color: #748dff;
    selection-color: #ffffff;
    padding: 4px;
}

/* --- Barra de Progresso --- */
QProgressBar {
    background-color: rgba(12, 14, 20, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    text-align: center;
    color: #ffffff;
    font-weight: 700;
    font-size: 11px;
    min-height: 20px;
    max-height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #748dff,
        stop:0.5 #9a73ff,
        stop:1.0 #b870ff);
    border-radius: 9px;
}

/* --- Checkboxes e Botões de Opção --- */
QCheckBox, QRadioButton {
    color: #e2e8f0;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.06);
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: rgba(255, 255, 255, 0.55);
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #748dff;
    border-color: #a970ff;
}

/* --- Tooltips e Barras de Rolagem --- */
QToolTip {
    background-color: #1a1e28;
    border: 1px solid rgba(255, 255, 255, 0.30);
    border-radius: 8px;
    color: #ffffff;
    padding: 6px 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0 2px 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px 0 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
