#!/bin/sh
set -e

case "$1" in
    configure)
        # Aplica os parâmetros sysctl do kernel com segurança
        if command -v sysctl >/dev/null 2>&1; then
            sysctl --system >/dev/null 2>&1 || true
        fi

        # Notifica o systemd com segurança somente se ele estiver em execução (PID 1)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl restart systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst chamado com argumento desconhecido \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
