<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>Lumen OS Project</vendor>
  <vendor_url>https://lumenos.dev</vendor_url>
  <icon_name>dev.lumenos.welcome</icon_name>

  <action id="dev.lumenos.welcome.policy">
    <description>Apply Lumen OS system optimizations</description>
    <description xml:lang="pt_BR">Aplicar otimizações de sistema do Lumen OS</description>
    <message>Authentication is required to configure system settings and package pinning</message>
    <message xml:lang="pt_BR">Autenticação necessária para configurar ajustes de sistema e pinning de pacotes</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/lumen-system-tune</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
