#!/usr/bin/env bash
set -euo pipefail

export XDG_CURRENT_DESKTOP="Lumen:Hyprland"
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="lumen-hyprland"
export PYTHONPATH="/usr/share/lumen-os:${PYTHONPATH:-}"

USER_CONF="$HOME/.config/hypr/hyprland.conf"
SYS_CONF="/usr/share/lumen-os/compositor/hyprland/hyprland.conf"

if [[ ! -f "$USER_CONF" ]]; then
    mkdir -p "$HOME/.config/hypr"
    if [[ -f "$SYS_CONF" ]]; then
        cp "$SYS_CONF" "$USER_CONF"
    fi
fi

CONF_TO_USE="$USER_CONF"
if [[ ! -f "$CONF_TO_USE" ]]; then
    CONF_TO_USE="$SYS_CONF"
fi

exec Hyprland -c "$CONF_TO_USE" "$@"
