<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>Lumen OS Project</vendor>
  <vendor_url>https://lumenos.dev</vendor_url>
  <icon_name>dev.lumenos.welcome</icon_name>

  <action id="dev.lumenos.root-helper">
    <description>Executar tarefas administrativas do Linux VDK</description>
    <description xml:lang="en">Run administrative tasks for Linux VDK</description>
    <message>É preciso autenticar para instalar pacotes e aplicar ajustes de sistema</message>
    <message xml:lang="en">Authentication is required to install packages and apply system settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/lumen-root-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
